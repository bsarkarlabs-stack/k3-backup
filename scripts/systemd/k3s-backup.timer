[Unit]
Description=Daily K3s server backup at 02:15 UTC

[Timer]
Unit=k3s-backup.service
# Its 30-minute service timeout plus this 10-minute delay finishes before the
# 03:30 UTC Velero schedule.
OnCalendar=*-*-* 02:15:00 UTC
# Catch up after a reboot or a missed window.
Persistent=true
RandomizedDelaySec=600
AccuracySec=1min

[Install]
WantedBy=timers.target
