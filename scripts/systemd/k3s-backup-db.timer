[Unit]
Description=K3s datastore snapshot every 6 hours (Track A, component 1)

[Timer]
Unit=k3s-backup@db.service
OnCalendar=*-*-* 00,06,12,18:20:00 UTC
# Catch up after a reboot or a missed window.
Persistent=true
# Avoid landing exactly on the same second as any other scheduled job.
RandomizedDelaySec=300
AccuracySec=1min

[Install]
WantedBy=timers.target
